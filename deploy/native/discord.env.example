CENTRAL_WSS_URL=wss://central.example.com/node
DISCORD_BOT_TOKEN=CHANGE_TO_DISCORD_BOT_TOKEN
DISCORD_DEFAULT_EMOJI_DIR=/opt/disqord/apps/discord-node/default-emojis
NODE_CONFIG_PATH=/var/lib/disqord/discord/node.json
NODE_QUEUE_PATH=/var/lib/disqord/discord/queue.json
NODE_LOG_PATH=./logs/discord-node.jsonl
NODE_WEB_HOST=127.0.0.1
NODE_WEB_PORT=8090
NODE_WEB_TOKEN=CHANGE_TO_AT_LEAST_16_RANDOM_CHARACTERS
NODE_WEB_ROOT=/opt/disqord/apps/node-web/dist
ALLOW_INSECURE_CENTRAL=false
