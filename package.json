{
  "name": "disqord",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A centrally orchestrated QQ and Discord message bridge.",
  "engines": {
    "node": ">=22.22.0 <25"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @disqord/central-server --filter @disqord/qq-node --filter @disqord/discord-node dev",
    "dev:central": "pnpm --filter @disqord/central-server dev",
    "dev:qq": "pnpm --filter @disqord/qq-node dev",
    "dev:discord": "pnpm --filter @disqord/discord-node dev",
    "dev:central-web": "pnpm --filter @disqord/central-web dev",
    "dev:node-web": "pnpm --filter @disqord/node-web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
