# Copy only the section needed by each server. Never commit the populated file.

# Central server
CENTRAL_HOST=127.0.0.1
CENTRAL_PORT=8080
CENTRAL_DATA_PATH=./data/central.json
# Generate with: openssl rand -hex 48
PAIRING_PEPPER=replace-with-at-least-32-random-characters
# true behind HTTPS; false only for local http:// testing.
COOKIE_SECURE=true

# Shared platform-node settings
CENTRAL_WSS_URL=wss://central.example.com/node
ALLOW_INSECURE_CENTRAL=false
NODE_WEB_HOST=127.0.0.1
NODE_WEB_PORT=8090
# Required if NODE_WEB_HOST is not loopback.
NODE_WEB_TOKEN=replace-with-at-least-16-random-characters
NODE_WEB_ROOT=./apps/node-web/dist
# install.sh uses this file for credentials entered in the first-run Web guide.
NODE_SETUP_PATH=./data/qq-setup.json

# QQ node / NapCat
NAPCAT_ONEBOT_WS_URL=ws://127.0.0.1:3001
NAPCAT_ACCESS_TOKEN=replace-in-local-env-only
NODE_CONFIG_PATH=./data/qq-node.json
NODE_QUEUE_PATH=./data/qq-queue.json

# Discord node
DISCORD_BOT_TOKEN=replace-in-local-env-only
NODE_SETUP_PATH=./data/discord-setup.json
NODE_CONFIG_PATH=./data/discord-node.json
NODE_QUEUE_PATH=./data/discord-queue.json

# LLM settings are configured in the central Web panel after first login.
# The provider must expose an OpenAI-compatible /chat/completions endpoint.
