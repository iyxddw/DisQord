{
  "name": "@disqord/node-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @disqord/shared build && pnpm --filter @disqord/queue build && pnpm --filter @disqord/transport build",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@disqord/card-renderer": "workspace:*",
    "@disqord/queue": "workspace:*",
    "@disqord/shared": "workspace:*",
    "@disqord/transport": "workspace:*",
    "zod": "4.4.3"
  }
}
