{
  "name": "@disqord/central-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "pretest": "pnpm --filter @disqord/shared build && pnpm --filter @disqord/transport build && pnpm --filter @disqord/blueprint build && pnpm --filter @disqord/card-renderer build && pnpm --filter @disqord/llm build",
    "start": "node dist/main.js",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@disqord/blueprint": "workspace:*",
    "@disqord/card-renderer": "workspace:*",
    "@disqord/chat-session": "workspace:*",
    "@disqord/llm": "workspace:*",
    "@disqord/shared": "workspace:*",
    "@disqord/transport": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.2",
    "fastify": "5.10.0",
    "zod": "4.4.3"
  }
}
